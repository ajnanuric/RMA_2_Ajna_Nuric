<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF5F7">

        <ImageView
            android:id="@+id/imageCity"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/paris"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/textCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paris"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textCityDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Romantic city with amazing food"
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/textCityBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget: 1500€"
                android:textColor="#E75480"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>