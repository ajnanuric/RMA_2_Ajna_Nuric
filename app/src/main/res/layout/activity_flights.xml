<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flights ✈️"
            android:textColor="#222222"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/editAirline"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/input_background"
            android:hint="Airline"
            android:padding="16dp"/>

        <EditText
            android:id="@+id/editDeparture"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/input_background"
            android:hint="Departure"
            android:padding="16dp"/>

        <EditText
            android:id="@+id/editArrival"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/input_background"
            android:hint="Arrival"
            android:padding="16dp"/>

        <EditText
            android:id="@+id/editPrice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/input_background"
            android:hint="Ticket price"
            android:padding="16dp"/>

        <Button
            android:id="@+id/buttonAddFlight"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#E75480"
            android:text="Add Flight"
            android:textAllCaps="false"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/textFlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#222222"
            android:textSize="16sp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>