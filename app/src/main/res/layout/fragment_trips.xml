<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/editDestination"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_background"
        android:hint="Destination"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/editDate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_background"
        android:hint="Date"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/editBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/input_background"
        android:hint="Budget"
        android:padding="16dp"/>

    <Button
        android:id="@+id/buttonAddTrip"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#E75480"
        android:text="Add Trip"
        android:textAllCaps="false"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget planner 💰"
        android:textColor="#222222"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/editFlightBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_background"
        android:hint="Flights budget"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/editHotelBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_background"
        android:hint="Hotel budget"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/editFoodBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_background"
        android:hint="Food budget"
        android:padding="16dp"/>

    <EditText
        android:id="@+id/editActivitiesBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/input_background"
        android:hint="Activities budget"
        android:padding="16dp"/>

    <Button
        android:id="@+id/buttonCalculate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#E75480"
        android:text="Calculate budget"
        android:textAllCaps="false"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/textBudgetResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTrips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"/>

</LinearLayout>